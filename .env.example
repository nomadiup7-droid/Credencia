# SECURITY
# Use long random values in production. Do not commit real secrets.
JWT_SECRET=

# SERVER
PORT=3000
APP_URL=http://localhost:3000

# DATABASE / PERSISTENCE
# Explicit provider selection is required. Use "supabase" for the real database.
# Use "local-json" only for explicit local development with db.json.
DATABASE_PROVIDER=supabase

# Supabase backend credentials. SUPABASE_SECRET_KEY is the preferred server-only key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Legacy compatibility only. Prefer SUPABASE_SECRET_KEY for new environments.
SUPABASE_SERVICE_ROLE_KEY=

# Public user-system signup is disabled by default.
# Administrators should be created with: npm run admin:create
ALLOW_PUBLIC_SIGNUP=false

# Optional direct PostgreSQL URL for future adapters/tools. The current backend
# uses the Supabase client above; keep this empty if it is not used locally.
DATABASE_URL=

# Optional AI integration.
GEMINI_API_KEY=
